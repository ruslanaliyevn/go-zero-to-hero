// ════════════════════════════════════════════════
// NORMAL RETURN (Adi üsul)
// ════════════════════════════════════════════════
func calculate(a int, b int) (int, string) {
    //                        └───┬───┘
    //                    Tipləri göstəririk, amma ad yoxdur
    
    result := a + b
    message := "Sum calculated"
    
    return result, message  // Dəyişənləri açıq şəkildə yazmalıyıq
    //     └──────┬──────┘
    //       Hər dəyişəni göstərməliyik
}

// ════════════════════════════════════════════════
// NAMED RETURN (Adlandırılmış return)
// ════════════════════════════════════════════════
func calculate(a int, b int) (result int, message string) {
    //                        └──────────┬──────────┘
    //                  Return dəyərlərinin adları var
    
    result = a + b                    // Adlandırılmış dəyişənə dəyər veririk
    message = "Sum calculated"        // Adlandırılmış dəyişənə dəyər veririk
    
    return  // ← NAKED RETURN (boş return)
    //     └─ Heç nə yazmırıq! Go avtomatik result və message-i qaytarır
}

------------------------------------------

🔍 Normal Function vs Function Literal:


// ════════════════════════════════════════════════
// NORMAL FUNCTION (Adi funksiya)
// ════════════════════════════════════════════════
func calculateTax(amount float64) float64 {
    //  └────┬────┘
    //   Funksiya ADI var
    return amount * 0.10
}

func main() {
    tax := calculateTax(100.0)  // Adı ilə çağırırıq
}

// ════════════════════════════════════════════════
// FUNCTION LITERAL (Adsız funksiya)
// ════════════════════════════════════════════════
func main() {
    // Funksiyanı DƏYİŞƏNƏ mənimsədirik
    calculateTax := func(amount float64) float64 {
        //             └──────────┬──────────┘
        //                  ADI YOXDUR!
        //             Birbaşa dəyişənə yazırıq
        return amount * 0.10
    }
    //  └─ Mötərizə bağlandı, funksiya tamamdır
    
    // İndi dəyişən kimi çağırırıq
    tax := calculateTax(100.0)
}
 
-----
 Closures in Function - 08_closures.go

Closure = Funksiya öz xüsusi yaddaşına malik olur və xarici dəyişənləri "saxlayır".
Bu nümunədə, adjustTemperature funksiyası baseTemperature dəyişənini "ələ keçirib" və hər dəfə çağırıldıqda onu dəyişdirir. Bu dəyişən funksiya bitdikdən sonra da yaşayır - bu closure-un xüsusiyyətidir.

